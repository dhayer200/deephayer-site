---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, summary, year, status, stack, links } = project.data;

const related = (await getCollection("essays", ({ data }) =>
  data.status === "published" && data.project === project.slug,
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const analysis = (await getCollection("analysis", ({ data }) =>
  data.status === "published" && data.project === project.slug,
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title={`${title} · Deep Hayer`} description={summary}>
  <article>
    <p class="trail"><a href="/projects">projects</a></p>
    <h1>{title}</h1>
    <p class="meta">{year} — {status}</p>
    <p><em>{summary}</em></p>

    {(links.live || links.github || links.paper) && (
      <p class="links">
        {links.live && <a href={links.live}>live</a>}
        {links.live && (links.github || links.paper) && " · "}
        {links.github && <a href={links.github}>github</a>}
        {links.github && links.paper && " · "}
        {links.paper && <a href={links.paper}>paper</a>}
      </p>
    )}

    {stack.length > 0 && <p class="stack"><span>stack:</span> {stack.join(", ")}</p>}

    <Content />

    {(related.length > 0 || analysis.length > 0) && (
      <section class="related">
        <h2>Related writing</h2>
        <ul>
          {related.map((p) => (
            <li><time>{fmt(p.data.date)}</time> <a href={`/essays/${p.slug}`}>{p.data.title}</a></li>
          ))}
          {analysis.map((p) => (
            <li><time>{fmt(p.data.date)}</time> <span class="cat">analysis</span> <a href={`/analysis/${p.slug}`}>{p.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>

<style>
  .trail { color: var(--fg-muted); font-size: 0.85rem; margin: 0 0 0.3em; }
  .trail a { color: var(--fg-muted); }
  .meta { color: var(--fg-muted); font-size: 0.9rem; margin: -0.5em 0 1.2em; }
  .links { font-size: 0.95rem; }
  .stack { color: var(--fg-muted); font-size: 0.9rem; }
  .stack span { font-style: italic; }
  .related ul { list-style: none; padding: 0; }
  .related time { color: var(--fg-muted); font-size: 0.88rem; display: inline-block; width: 6rem; }
  .related .cat { color: var(--fg-muted); font-style: italic; font-size: 0.88rem; margin-right: 0.4em; }
</style>
