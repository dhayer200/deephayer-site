---
import Layout from "../layouts/Layout.astro";
import ProjectList from "../components/ProjectList.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projectItems = projects.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  summary: p.data.summary,
  year: p.data.year,
  status: p.data.status,
  tags: p.data.tags,
}));

const writing = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout>
  <article class="prose">
    <h1 class="prose-title">Deep Hayer</h1>
    <p class="lede">
      Applied math and business student in Austin. I build things and write
      about what I learn — markets, models, and the people behind the deals.
    </p>

    <h2>Projects</h2>
    <ProjectList items={projectItems} />

    <h2>Essais</h2>
    {writing.length > 0 ? (
      <ul class="essais">
        {writing.map((w) => (
          <li>
            <span class="date">{fmt(w.data.date)}</span>
            <a href={`/essais/${w.slug}`}>{w.data.title}</a>
            {w.data.summary && <span class="excerpt"> — {w.data.summary}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty"><em>Nothing published yet. Soon.</em></p>
    )}

    <h2>Elsewhere</h2>
    <p>
      <a href="mailto:deephayer940@gmail.com">Email</a>,
      <a href="https://github.com/dhayer200">GitHub</a>,
      <a href="https://www.linkedin.com/in/deep-hayer-19ba8b366">LinkedIn</a>,
      <a href="/graph">the graph</a>.
    </p>
  </article>
</Layout>

<style>
  .essais { list-style: none; padding: 0; margin: 0; }
  .essais li {
    padding: 0.3rem 0;
    border-bottom: 1px dotted var(--rule);
    font-size: 0.98rem;
  }
  .essais li:last-child { border-bottom: none; }
  .essais .date {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    margin-right: 0.6em;
  }
  .essais a { color: var(--fg); text-decoration: none; font-weight: 600; }
  .essais a:hover { color: var(--accent); }
  .essais .excerpt { color: var(--fg-muted); }
  .empty { color: var(--fg-muted); }
</style>
