---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const recent = (await getCollection("essays", ({ data }) => data.status === "published"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const recentAnalysis = (
  await getCollection("analysis", ({ data }) => data.status === "published")
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const projects = (await getCollection("projects"))
  .filter((p) => p.data.status === "building")
  .sort((a, b) => a.data.order - b.data.order);

const fmt = (d: Date) =>
  d.toISOString().slice(0, 10);
---

<Layout>
  <p class="intro">
    Applied math and business student in Austin. I write here about markets,
    models, philosophy, and the deals I watch.
  </p>

  <section>
    <h2>Currently</h2>
    <ul>
      <li>A math major. I got my associates in business administration and mathematics at ACC.</li>
      <li>Continuing to learn more and more each day about philosophy, literature, math, finance, psychology, real estate, and more.</li>
      <li>Building a sports prediction model for college basketball and college football.</li>
      <li>Building a comps automation system for investors, agents, and brokerages.</li>
      <li>Building a college acceptance prediction model and helping upcoming applicants revise their application strategy.</li>
      <li>Building theory and a bot for Monopoly, and creating an online platform to play it on.</li>
      <li>Writing a paper on the Texas housing market — twenty years of history, a five year forecast, three rate-path scenarios.</li>
      <li>A data analysis on rural healthcare access in Kansas for the ASA DataFest competition.</li>
    </ul>
  </section>

  <section>
    <h2>Recent essays</h2>
    {recent.length > 0 ? (
      <ul class="post-list">
        {recent.map((p) => (
          <li>
            <time>{fmt(p.data.date)}</time>
            <a href={`/essays/${p.slug}`}>{p.data.title}</a>
          </li>
        ))}
      </ul>
    ) : <p class="dim">Nothing yet.</p>}
  </section>

  <section>
    <h2>Recent analysis</h2>
    {recentAnalysis.length > 0 ? (
      <ul class="post-list">
        {recentAnalysis.map((p) => (
          <li>
            <time>{fmt(p.data.date)}</time>
            <span class="cat">{p.data.category}</span>
            <a href={`/analysis/${p.slug}`}>{p.data.title}</a>
          </li>
        ))}
      </ul>
    ) : <p class="dim">Nothing yet.</p>}
  </section>

  <section>
    <h2>Active projects</h2>
    <ul class="post-list">
      {projects.map((p) => (
        <li>
          <a href={`/projects/${p.slug}`}>{p.data.title}</a>
          <span class="dim"> — {p.data.summary}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Elsewhere</h2>
    <p>
      <a href="mailto:deephayer940@gmail.com">email</a>,
      <a href="https://github.com/dhayer200">github</a>,
      <a href="https://www.linkedin.com/in/deep-hayer-19ba8b366">linkedin</a>.
    </p>
  </section>
</Layout>

<style>
  .intro { color: var(--fg-muted); margin: 0 0 1.5rem; }
  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list li { padding: 0.2em 0; }
  .post-list time, .post-list .cat {
    display: inline-block;
    width: 6.2rem;
    color: var(--fg-muted);
    font-size: 0.88rem;
  }
  .post-list .cat { width: auto; margin-right: 0.6rem; font-style: italic; }
  .dim { color: var(--fg-muted); }
  section { margin-bottom: 1.5rem; }
</style>
