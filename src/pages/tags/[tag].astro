---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const e = await getCollection("essays", ({ data }) => data.status === "published");
  const a = await getCollection("analysis", ({ data }) => data.status === "published");
  const n = await getCollection("notes", ({ data }) => data.status === "published");
  const p = await getCollection("projects");
  const tags = new Set<string>();
  [...e, ...a, ...n, ...p].forEach((x) => x.data.tags.forEach((t) => tags.add(t)));
  return [...tags].map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;

const fmt = (d: Date) => d.toISOString().slice(0, 10);

const e = (await getCollection("essays", ({ data }) =>
  data.status === "published" && data.tags.includes(tag),
)).map((p) => ({ href: `/essays/${p.slug}`, title: p.data.title, date: p.data.date, sec: "essay" }));

const a = (await getCollection("analysis", ({ data }) =>
  data.status === "published" && data.tags.includes(tag),
)).map((p) => ({ href: `/analysis/${p.slug}`, title: p.data.title, date: p.data.date, sec: `analysis · ${p.data.category}` }));

const n = (await getCollection("notes", ({ data }) =>
  data.status === "published" && data.tags.includes(tag),
)).map((p) => ({ href: `/notes/${p.slug}`, title: p.data.title, date: p.data.date, sec: "note" }));

const items = [...e, ...a, ...n].sort((x, y) => y.date.valueOf() - x.date.valueOf());
---

<Layout title={`#${tag} · Deep Hayer`}>
  <h1>#{tag}</h1>
  <p class="dim">{items.length} item{items.length !== 1 && "s"}.</p>
  <ul class="list">
    {items.map((i) => (
      <li>
        <time>{fmt(i.date)}</time>
        <span class="sec">{i.sec}</span>
        <a href={i.href}>{i.title}</a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .dim { color: var(--fg-muted); }
  .list { list-style: none; padding: 0; }
  .list li { padding: 0.2em 0; }
  .list time { display: inline-block; width: 6.2rem; color: var(--fg-muted); font-size: 0.88rem; }
  .list .sec { color: var(--fg-muted); font-size: 0.88rem; font-style: italic; margin-right: 0.6rem; }
</style>
