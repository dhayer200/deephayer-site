---
import Layout from "../layouts/Layout.astro";
import Graph from "../components/Graph.astro";
---

<Layout title="Graph · Deep Hayer" wide>
  <h1 class="page-title">Knowledge graph</h1>
  <p class="lede">
    Every essai and project as a node. Wikilinks between them as edges. Drag to
    rearrange, click to open. Built from the same engine as
    <a href="https://github.com/dhayer200/wiki.nvim">wiki.nvim</a>, filtered to
    the published subset.
  </p>
  <Graph />
</Layout>

<style>
  .page-title { font-family: var(--font-ui); font-size: 2rem; margin: 1rem 0 0.5rem; }
  .lede { color: var(--fg-muted); max-width: 36rem; margin: 0 0 1.5rem; }
</style>
