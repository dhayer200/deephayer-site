---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const writing = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const allTags = Array.from(
  new Set(writing.flatMap((w) => w.data.tags)),
).sort();

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="Essais · Deep Hayer">
  <article class="prose">
    <h1 class="page-title">Essais</h1>
    <p class="lede">
      After Montaigne. Writing on what I am learning, what I am building, and the
      deals I am watching in Austin.
    </p>

    {allTags.length > 0 && (
      <p class="tags">
        {allTags.map((t) => (
          <a class="tag-chip" href={`/tags/${t}`}>#{t}</a>
        ))}
      </p>
    )}

    {writing.length > 0 ? (
      <ul class="essais">
        {writing.map((w) => (
          <li>
            <span class="date">{fmt(w.data.date)}</span>
            <a href={`/essais/${w.slug}`}>{w.data.title}</a>
            {w.data.summary && <span class="excerpt"> — {w.data.summary}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty"><em>Nothing published yet. The first essai is being drafted.</em></p>
    )}
  </article>
</Layout>

<style>
  .tags { margin: 0 0 1.5rem; }
  .essais { list-style: none; padding: 0; margin: 0; }
  .essais li {
    padding: 0.4rem 0;
    border-bottom: 1px dotted var(--rule);
  }
  .essais .date {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    margin-right: 0.6em;
  }
  .essais a { color: var(--fg); text-decoration: none; font-weight: 600; }
  .essais a:hover { color: var(--accent); }
  .essais .excerpt { color: var(--fg-muted); }
  .empty { color: var(--fg-muted); }
</style>
