---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const writing = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const allTags = Array.from(
  new Set(writing.flatMap((w) => w.data.tags)),
).sort();

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="Essais · Deep Hayer">
  <h1 class="page-title">Essais</h1>
  <p class="lede">
    After Montaigne. Writing about what I'm learning, what I'm building, and the
    deals I'm watching in Austin.
  </p>

  {allTags.length > 0 && (
    <div class="tags">
      {allTags.map((t) => (
        <a class="tag-chip" href={`/tags/${t}`}>#{t}</a>
      ))}
    </div>
  )}

  <ul class="list">
    {writing.map((w) => (
      <li>
        <a href={`/essais/${w.slug}`}>
          <span class="date">{fmt(w.data.date)}</span>
          <span class="title">{w.data.title}</span>
          {w.data.summary && <span class="excerpt">{w.data.summary}</span>}
        </a>
      </li>
    ))}
    {writing.length === 0 && (
      <li class="empty">Nothing published yet. The first essai is being drafted.</li>
    )}
  </ul>
</Layout>

<style>
  .page-title { font-family: var(--font-ui); font-size: 2rem; margin: 1rem 0 0.5rem; }
  .lede { color: var(--fg-muted); max-width: 36rem; margin: 0 0 1.5rem; }
  .tags { margin: 0 0 2rem; }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    color: var(--fg);
    text-decoration: none;
  }
  .date { font-family: var(--font-ui); font-size: 0.85rem; color: var(--fg-muted); }
  .title { font-weight: 500; }
  .excerpt { grid-column: 2; font-size: 0.92rem; color: var(--fg-muted); margin-top: 0.25rem; }
  .list a:hover .title { color: var(--accent); }
  .empty { color: var(--fg-muted); font-style: italic; padding: 1rem 0; }
  @media (max-width: 600px) {
    .list a { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
