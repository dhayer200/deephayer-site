---
import Layout from "../../layouts/Layout.astro";
import Toc from "../../components/Toc.astro";
import Backlinks from "../../components/Backlinks.astro";
import { getCollection } from "astro:content";
import linkGraph from "../../data/link-graph.json";

export async function getStaticPaths() {
  const essais = await getCollection("writing", ({ data }) => !data.draft);
  return essais.map((e) => ({ params: { slug: e.slug }, props: { essai: e } }));
}

const { essai } = Astro.props;
const { Content, headings } = await essai.render();
const { title, date, tags, summary } = essai.data;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const backlinks = (linkGraph.backlinks?.[`essai/${essai.slug}`] ?? []) as {
  title: string;
  href: string;
  kind: "essai" | "project";
}[];

const all = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const idx = all.findIndex((e) => e.slug === essai.slug);
const prev = idx < all.length - 1 ? all[idx + 1] : null;
const next = idx > 0 ? all[idx - 1] : null;
---

<Layout title={`${title} · Essais`} description={summary} wide>
  <div class="layout">
    <article class="prose essai-body">
      <h1 class="prose-title">{title}</h1>
      <div class="meta">
        <time>{fmt(date)}</time>
        {tags.length > 0 && (
          <>
            {" · "}
            {tags.map((t) => (
              <a class="tag-chip" href={`/tags/${t}`}>#{t}</a>
            ))}
          </>
        )}
      </div>
      <Content />
      <Backlinks items={backlinks} />
      <nav class="prev-next">
        {prev && (
          <a href={`/essais/${prev.slug}`} class="prev">
            <span>← Previous</span>
            <span class="t">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a href={`/essais/${next.slug}`} class="next">
            <span>Next →</span>
            <span class="t">{next.data.title}</span>
          </a>
        )}
      </nav>
    </article>
    <aside class="toc-aside">
      <Toc headings={headings} />
    </aside>
  </div>
</Layout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--content-width)) 14rem;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 1099px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .toc-aside { display: none; }
  }
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }
  .prev-next a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--fg-muted);
  }
  .prev-next .next { text-align: right; }
  .prev-next .t { color: var(--fg); margin-top: 0.2rem; }
  .prev-next a:hover .t { color: var(--accent); }
</style>
