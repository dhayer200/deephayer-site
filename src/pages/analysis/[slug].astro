---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("analysis", ({ data }) => data.status === "published");
  return posts
    .filter((p) => !["sports", "cre", "ma", "finance", "data"].includes(p.slug))
    .map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, date, tags, description, category } = post.data;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title={`${title} · Analysis`} description={description}>
  <article>
    <p class="trail"><a href="/analysis">analysis</a> / <a href={`/analysis/${category}`}>{category}</a></p>
    <h1>{title}</h1>
    <p class="meta">
      <time>{fmt(date)}</time>
      {tags.length > 0 && <>
        {" — "}
        {tags.map((t, i) => (
          <>
            <a href={`/tags/${t}`}>#{t}</a>{i < tags.length - 1 && " "}
          </>
        ))}
      </>}
    </p>
    {description && <p class="desc"><em>{description}</em></p>}
    <Content />
  </article>
</Layout>

<style>
  .trail { color: var(--fg-muted); font-size: 0.85rem; margin: 0 0 0.5em; }
  .trail a { color: var(--fg-muted); }
  .meta { color: var(--fg-muted); font-size: 0.9rem; margin: -0.5em 0 1.5em; }
  .meta a { color: var(--fg-muted); }
  .desc { color: var(--fg-muted); margin: 0 0 1.5em; }
</style>
