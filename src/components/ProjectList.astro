---
interface Project {
  slug: string;
  title: string;
  summary: string;
  year: string;
  status: string;
  tags?: string[];
}
interface Props { items: Project[] }
const { items } = Astro.props;
---

<dl class="proj-list">
  {items.map((p) => (
    <>
      <dt>
        <a href={`/projects/${p.slug}`}>{p.title}</a>
        <span class="meta">
          <span class="year">{p.year}</span>
          <span class="sep">·</span>
          <span class={`status status-${p.status}`}>{p.status}</span>
        </span>
      </dt>
      <dd>{p.summary}</dd>
    </>
  ))}
</dl>

<style>
  .proj-list {
    margin: 0;
    padding: 0;
  }
  .proj-list dt {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: 1.1rem;
    font-family: var(--font-body);
  }
  .proj-list dt a {
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
  }
  .proj-list dt a:hover { color: var(--accent); }
  .proj-list .meta {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .proj-list .sep { margin: 0 0.4em; color: var(--fg-faint); }
  .proj-list .status-shipped { color: var(--accent); }
  .proj-list dd {
    margin: 0.2em 0 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
    text-align: justify;
    hyphens: auto;
  }
</style>
