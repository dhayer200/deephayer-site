---
interface BL { title: string; href: string; kind: "essai" | "project" }
interface Props { items: BL[] }
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="backlinks">
    <h2>Backlinks</h2>
    <ul>
      {items.map((i) => (
        <li>
          <span class={`kind kind-${i.kind}`}>{i.kind}</span>
          <a href={i.href}>{i.title}</a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .backlinks { margin-top: 3rem; }
  .backlinks h2 {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
    color: var(--fg-muted);
  }
  ul { list-style: none; padding: 0; margin: 0; }
  li { padding: 0.3rem 0; font-family: var(--font-ui); font-size: 0.9rem; }
  .kind {
    display: inline-block;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    margin-right: 0.6em;
    min-width: 4.5em;
  }
  .kind-project { color: var(--accent); }
</style>
