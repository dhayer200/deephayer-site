---
interface Props {
  slug: string;
  title: string;
  summary: string;
  year: string;
  status: string;
  tags?: string[];
}

const { slug, title, summary, year, status, tags = [] } = Astro.props;
---

<a class="card" href={`/projects/${slug}`}>
  <div class="top">
    <span class="title">{title}</span>
    <span class={`status status-${status}`}>{status}</span>
  </div>
  <p class="summary">{summary}</p>
  <div class="bottom">
    <span class="year">{year}</span>
    <span class="tags">{tags.slice(0, 3).join(" · ")}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--fg);
    text-decoration: none;
    background: var(--bg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
  .title { font-family: var(--font-ui); font-weight: 600; font-size: 1.05rem; }
  .status {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    border: 1px solid var(--rule);
    padding: 0.1em 0.5em;
    border-radius: 999px;
  }
  .status-shipped { color: var(--accent); border-color: var(--accent); }
  .summary {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.5;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-top: auto;
  }
</style>
