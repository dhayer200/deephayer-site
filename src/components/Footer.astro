---
const year = new Date().getFullYear();
---

<footer>
  <div class="row">
    <span>© {year} Deep Hayer</span>
    <span class="links">
      <a href="mailto:deephayer940@gmail.com">email</a>
      <a href="https://github.com/dhayer200" target="_blank" rel="noopener">github</a>
      <a href="https://www.linkedin.com/in/deep-hayer-19ba8b366" target="_blank" rel="noopener">linkedin</a>
      <a href="/graph">graph</a>
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--rule);
    padding: 1.2rem 1.25rem 1.8rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .row {
    max-width: var(--wide-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .links { display: flex; gap: 1rem; flex-wrap: wrap; }
  .links a { color: var(--fg-muted); text-decoration: none; }
  .links a:hover { color: var(--accent); }
</style>
