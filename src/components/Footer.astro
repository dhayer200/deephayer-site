---
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <span>© {year} Deep Hayer</span>
    <span>
      <a href="mailto:deephayer940@gmail.com">email</a>
      <span class="sep">·</span>
      <a href="https://github.com/dhayer200">github</a>
      <span class="sep">·</span>
      <a href="/archive">archive</a>
      <span class="sep">·</span>
      <a href="/rss.xml">rss</a>
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--rule);
    padding: 1rem 1.25rem 1.5rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-top: 3rem;
  }
  .wrap {
    max-width: var(--content);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sep { color: var(--fg-faint); margin: 0 0.3em; }
  a { color: var(--fg-muted); text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
